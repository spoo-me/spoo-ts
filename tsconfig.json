{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "declaration": true,
    "noEmit": true,
    "types": [],
    "paths": {
      "spoo.me": ["./src/index.ts"]
    }
  },
  "include": ["src", "tests", "examples", "tsdown.config.ts", "vitest.config.ts"]
}
